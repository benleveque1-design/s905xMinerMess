# Minimal S905X (Meson GXL) mining kernel fragment - everything =y, no modules
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_ARCH_MESON=y

# serial console
CONFIG_TTY=y
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y

# boot essentials
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_PRINTK=y
CONFIG_BLK_DEV_INITRD=n

# storage (eMMC/SD)
CONFIG_BLOCK=y
CONFIG_PCI=n
CONFIG_USB=n
CONFIG_SCSI=n
CONFIG_MD=y
CONFIG_BLK_DEV_MD=n
CONFIG_BLK_DEV_DM=n
CONFIG_SD_MOD=n
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MESON_GX=y

# clocks / pinctrl / soc
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_GXBB=y
CONFIG_PINCTRL_MESON_GXL=y

# cpufreq + thermal
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_THERMAL=y
CONFIG_AMLOGIC_THERMAL=y

# network (TCP + ethernet for stratum)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_MESON=y
CONFIG_MDIO_DEVICE=y
CONFIG_PHYLIB=y
CONFIG_REALTEK_PHY=y
CONFIG_WIRELESS=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n
CONFIG_EXT4_FS=y
