label Armbian_community
  kernel /Image
  # initrd /uInitrd  # B1: removed (kernel has MMC_MESON_GX=y EXT4_FS=y DEVTMPFS_MOUNT=y)
  fdt /dtb/amlogic/meson-gxl-s905x-p212.dtb
  append root=PARTUUID=937d0000-02 rootflags=data=writeback console=ttyAML0,115200n8 console=tty0 rw no_console_suspend consoleblank=0 fsck.fix=yes fsck.repair=yes net.ifnames=0
