# Shared secret used by the controller, all worker agents, and mutating REST calls.
# Generate one with: openssl rand -hex 32
WORKER_AUTH_TOKEN=change-me

# Optional: bake the same token into the dashboard build so its REST fallback
# calls can authenticate (the WebSocket control path does not need it).
VITE_WORKER_AUTH_TOKEN=

# Optional overrides (defaults shown)
PORT=3010
NODE_ENV=production

# Default mining pool broadcast to workers on auth (optional; falls back to sandbox defaults)
# POOL_URL=stratum+tcp://pool.basedmining.xyz:3335
# POOL_USER=<btc-address>.workername
# POOL_PASS=x
